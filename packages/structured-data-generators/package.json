{
  "name": "structured-data-generators",
  "version": "0.1.2",
  "description": "Type-safe schema.org structured data factories and safe JSON-LD serialization",
  "keywords": [
    "json-ld",
    "jsonld",
    "schema.org",
    "seo",
    "structured-data",
    "typescript"
  ],
  "homepage": "https://github.com/VIKTORVAV99/structured-data-generators",
  "license": "MIT",
  "author": "Viktor Andersson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VIKTORVAV99/structured-data-generators.git",
    "directory": "packages/structured-data-generators"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test \"tests/**/*.test.ts\"",
    "prepublishOnly": "rm -rf dist && npm run build && npx publint && npm_config_dry_run=false npx @arethetypeswrong/cli --pack . --profile esm-only"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
